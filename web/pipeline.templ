package web

type PipelineData struct {
	Source string
	Submitted uint64
	Processed uint64
	Rejected uint64
	Stored int64
}

templ Pipeline(data PipelineData) {
	<section class="bw-panel p-4" aria-label="Observation pipeline">
		<h2 class="font-semibold">Observation processing</h2>
		<p class="text-sm mt-1">{ data.Source }</p>
		<dl class="flex flex-wrap gap-x-8 gap-y-3 mt-3 text-sm">
			<div><dt>Accepted</dt><dd data-counter="submitted">{ data.Submitted }</dd></div>
			<div><dt>Detector returns</dt><dd data-counter="processed">{ data.Processed }</dd></div>
			<div><dt>Rejected</dt><dd data-counter="rejected">{ data.Rejected }</dd></div>
			<div><dt>Stored samples</dt><dd data-counter="stored">{ data.Stored }</dd></div>
		</dl>
		<p class="text-xs mt-3 opacity-70">Accepted work is in memory, not guaranteed durable. Stored samples are read independently from SQLite.</p>
	</section>
}
